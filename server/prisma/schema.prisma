generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String
  email      String?  @unique
  name       String?
  username   String?  @unique
  avatar     String?
  sex        String?
  birthday   DateTime?
  heightCm   Float?
  weightKg   Float?
  onboardingCompleted Boolean @default(false)
  onboardingAnswers   Json?
  createdAt  DateTime @default(now())
  aiChatConversations AiChatConversation[]
  aiChatMessages      AiChatMessage[]
  aiAgentRuns         AiAgentRun[]
  appState            UserAppState?

  @@unique([provider, providerId])
}

model AiAgentRun {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentType    String   @map("agent_type")
  success      Boolean  @default(false)
  usedFallback Boolean  @default(false) @map("used_fallback")
  latencyMs    Int?     @map("latency_ms")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([agentType, createdAt])
  @@map("ai_agent_runs")
}

model UserAppState {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planState  Json?
  workoutLogs Json?
  restDays   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Muscle {
  id        BigInt     @id
  name      String
  slug      String     @unique
  side      String
  regionId  String     @map("region_id")
  exercises Exercise[] @relation("PrimaryMuscle")
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("muscles")
}

model Equipment {
  id        BigInt               @id
  name      String
  slug      String               @unique
  exercises ExerciseEquipment[]
  createdAt DateTime             @default(now()) @map("created_at")

  @@map("equipments")
}

model Exercise {
  id              BigInt               @id
  name            String
  slug            String               @unique
  difficulty      String?
  primaryMuscleId BigInt?              @map("primary_muscle_id")
  primaryMuscle   Muscle?              @relation("PrimaryMuscle", fields: [primaryMuscleId], references: [id])
  instructions    Json
  notes           String?
  media           Json?
  equipments      ExerciseEquipment[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")

  @@index([primaryMuscleId])
  @@map("exercises")
}

model ExerciseEquipment {
  exerciseId  BigInt    @map("exercise_id")
  equipmentId BigInt    @map("equipment_id")
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
  @@map("exercise_equipments")
}

model AiChatConversation {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, updatedAt])
}

model AiChatMessage {
  id             Int                @id @default(autoincrement())
  conversationId Int
  userId         Int
  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}
