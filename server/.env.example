PORT=4000
APP_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# Frontend build note:
# VITE_AUTH_SERVER_ORIGIN must point to this deployed Node server in production.
# Example: https://api.keepfit.it.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback


SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=Fitness AI Planner
RESEND_REPLY_TO=support@example.com

# AI chat gateway -> RunPod /chat
# Must be the full chat endpoint, not only the RunPod root URL.
AI_CHAT_API_URL=https://your-runpod-endpoint.proxy.runpod.net/chat
# Must exactly match backend/.env INBOUND_API_KEY
AI_CHAT_API_KEY=match-backend-inbound-api-key
AI_CHAT_API_FORMAT=custom
# Optional:
# AI_CHAT_MODEL=
# AI_CHAT_TIMEOUT_MS=25000
# AI_CHAT_ANALYTICS_PATH=/analytics/insight

JWT_SECRET=change-me-to-a-strong-secret

DATABASE_URL=postgresql://devuser:devpass@localhost:5432/fitness
